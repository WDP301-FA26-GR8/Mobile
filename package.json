{
  "name": "software-license-management-mobile",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.1.3",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --android",
    "api:generate": "pnpm api:validate && node ./scripts/clean-generated-mocks.mjs && orval --config ./orval.config.ts",
    "api:validate": "node ./scripts/validate-openapi.mjs ./openapi/openapi.yaml",
    "api:watch": "pnpm api:validate && node ./scripts/clean-generated-mocks.mjs && orval --config ./orval.config.ts --watch",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm security:test",
    "export:web": "expo export --platform web",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "security:test": "node --test security-tests/*.test.cjs",
    "security:audit": "pnpm audit --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq",
    "start": "expo start",
    "test": "jest --runInBand && node --test scripts/*.test.mjs eslint-rules/*.test.cjs",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.5.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "orval": "^8.24.0",
    "prettier": "3.9.6",
    "test-renderer": "1.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@faker-js/faker|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
