# Public client configuration only. Never put secrets in EXPO_PUBLIC_* values.
# Android emulators usually need http://10.0.2.2:3000 instead of localhost.
# Deployed API: https://wdp.novaproj.site (Expo web additionally needs CORS permission).
# Do not append /api/v1; generated operation paths already include it.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
